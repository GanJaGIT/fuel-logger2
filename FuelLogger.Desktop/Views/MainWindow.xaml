<Window x:Class="FuelLogger.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FuelLogger.Desktop.ViewModels"
        xmlns:views="clr-namespace:FuelLogger.Desktop.Views"
        Title="Fuel Logger" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0,0,0,10">
            <MenuItem Header="Файл">
                <MenuItem Header="Создать проект" Command="{Binding CreateProjectCommand}"/>
                <MenuItem Header="Открыть проект" Command="{Binding OpenProjectCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Настройки"/>
            <MenuItem Header="Справка"/>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Подразделения" FontWeight="Bold" Margin="5"/>

                    <TreeView Grid.Row="1" x:Name="DepartmentsTree" ItemsSource="{Binding Departments}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Visibility="{Binding Level, Converter={StaticResource LevelToVisibilityConverter}}"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Button Grid.Row="1" Content="Добавить подразделение" 
                            Command="{Binding AddDepartmentCommand}"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                            Margin="5" Padding="5"/>
                </Grid>
            </Border>

            <TabControl Grid.Column="1" Margin="5,0,0,0">
                <TabItem Header="Транспорт">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding StatisticsText}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="Обновить" Command="{Binding UpdateFleetCommand}" Margin="10,0,0,0" Padding="5"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding FleetItems}" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ТС" Binding="{Binding Vehicle.Name}" Width="*"/>
                                <DataGridTextColumn Header="Топливо" Binding="{Binding Vehicle.FuelType}" Width="80"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="Объём бака (л)" Binding="{Binding Vehicle.TankVolume}" Width="120"/>
                                <DataGridTextColumn Header="Категория" Binding="{Binding Vehicle.Category}" Width="*"/>
                                <DataGridTextColumn Header="Суммарный объём (л)" Binding="{Binding TotalTankVolume}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="Gray" FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Типовой транспорт">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Обновить" Command="{Binding LoadVehiclesCommand}" Margin="0,0,5,0" Padding="5"/>
                            <Button Content="Добавить" Command="{Binding AddVehicleCommand}" Margin="0,0,5,0" Padding="5"/>
                            <Button Content="Редактировать" Command="{Binding EditVehicleCommand}" Margin="0,0,5,0" Padding="5"/>
                            <Button Content="Удалить" Command="{Binding DeleteVehicleCommand}" Margin="0,0,5,0" Padding="5"/>
                            <TextBlock Text="{Binding VehicleStatusText}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Vehicles}" 
                                  AutoGenerateColumns="True" IsReadOnly="True"
                                  SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Text="{Binding VehicleStatusText}" Foreground="Gray" FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Вычисления">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding TaskTypes}" 
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedTaskType}"
                                      MinWidth="150" Margin="0,0,5,0"/>
                            <Button Content="Обновить" Command="{Binding LoadTasksCommand}" Margin="0,0,5,0" Padding="5"/>
                            <Button Content="Создать задачу" Command="{Binding CreateTaskCommand}" Margin="0,0,5,0" Padding="5"/>
                            <Button Content="Рассчитать" Command="{Binding CalculateTasksCommand}" Margin="0,0,5,0" Padding="5"/>
                            <Button Content="Удалить" Command="{Binding DeleteTasksCommand}" Margin="0,0,5,0" Padding="5"/>
                            <TextBlock Text="{Binding TaskStatusText}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected, Mode=TwoWay}" Width="50"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding TaskType.Name}" Width="150"/>
                                <DataGridTextColumn Header="Подразделение" Binding="{Binding Department.Name}" Width="150"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                                <DataGridTextColumn Header="ТС" Binding="{Binding Vehicles.Count}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="{Binding TaskStatusText}" Foreground="Gray" FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Отчёты">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Обновить" Command="{Binding LoadReportsCommand}" Margin="0,0,5,0" Padding="5"/>
                            <Button Content="Открыть" Command="{Binding OpenReportCommand}" Margin="0,0,5,0" Padding="5"/>
                            <Button Content="Удалить" Command="{Binding DeleteReportCommand}" Margin="0,0,5,0" Padding="5"/>
                            <TextBlock Text="{Binding ReportStatusText}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Reports}" 
                                  AutoGenerateColumns="True" IsReadOnly="True"
                                  SelectedItem="{Binding SelectedReport, Mode=TwoWay}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Text="{Binding ReportStatusText}" Foreground="Gray" FontStyle="Italic"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>